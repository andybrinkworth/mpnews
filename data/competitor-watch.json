---
---
{
  "title": "Competitor Watch Digest",
  "cadence": "Weekly (Fridays midday UK)",
  "entries": [
    {% for item in site.competitor_watch %}
    {
      "date": {{ item.date | date: "%Y-%m-%d" | jsonify }},
      "heading": {{ item.title | jsonify }},
      "summary": {{ item.content | jsonify }},
      "link": {{ item.link | default: "" | jsonify }},
      "tags": {{ item.tags | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}

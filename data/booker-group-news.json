---
---
{
  "title": "Booker Group News Digest",
  "cadence": "Weekly (Mondays 06:00 UK)",
  "entries": [
    {% for item in site.booker_group_news %}
    {
      "date": {{ item.date | date: "%Y-%m-%d" | jsonify }},
      "heading": {{ item.title | jsonify }},
      "summary": {{ item.content | strip_html | strip_newlines | strip | jsonify }},
      "link": {{ item.link | default: "" | jsonify }},
      "tags": {{ item.tags | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
